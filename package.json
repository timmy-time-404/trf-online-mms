{
  "name": "trf-online-mms",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @trf/shared build && pnpm --parallel --filter @trf/api --filter @trf/web dev",
    "dev:setup": "node scripts/dev.mjs setup",
    "dev:db": "docker compose -f compose.dev.yaml up -d --wait",
    "dev:db:stop": "docker compose -f compose.dev.yaml stop",
    "db:init": "node scripts/dev.mjs db:init",
    "db:reset": "node scripts/dev.mjs db:reset",
    "dev:web": "pnpm --filter @trf/shared build && pnpm --filter @trf/web dev",
    "dev:api": "pnpm --filter @trf/shared build && pnpm --filter @trf/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @trf/shared build && pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
