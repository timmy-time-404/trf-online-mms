{
  "name": "@trf/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "pnpm build && node dist/modules/trf/integration.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@trf/shared": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.21",
    "postgres": "4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
