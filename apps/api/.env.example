NODE_ENV=development
PORT=3000
# Runtime auth requires APP_ORIGIN and a restricted DB user; never trf_owner.
# APP_ORIGIN=https://meong-mms.org
# Connection variables also used by administrative migration/seed commands:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=trf
# DB_USER=trf_api
# DB_PASSWORD_FILE=/absolute/path/to/postgres_password
# DB_MIGRATIONS_DIR=../../db/migrations
# SEED_CONFIRM=trf-development-dummy-only
# SEED_CREDENTIALS_FILE=/private/path/to/dummy-accounts.json
