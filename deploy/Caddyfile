{
    admin off
    auto_https off
    persist_config off
}

:8080 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        # Internal app: never framed, never indexed. Scripts only from this origin, so an
        # injected tag cannot run. Inline styles stay allowed for Radix/sonner and the PDF export.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        X-Frame-Options DENY
        X-Robots-Tag "noindex, nofollow"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    handle_path /api/* {
        header Cache-Control no-store
        reverse_proxy api:3000
    }
    # Vite assets have content hashes in their names, so they can be cached forever.
    @assets path /assets/*
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv
        file_server
    }
    handle {
        header Cache-Control no-store
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
