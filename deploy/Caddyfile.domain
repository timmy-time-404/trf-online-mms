{
    admin off
    persist_config off
}

{$APP_DOMAIN} {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy gateway:8080
}

# www -> apex is a Cloudflare Redirect Rule. The origin cannot get a certificate for www
# behind Cloudflare's forced HTTPS, so it must not serve that name (it would retry ACME forever).

# Container-only liveness; public certificate validity is checked separately.
:8081 {
    respond /health "ok" 200
}
